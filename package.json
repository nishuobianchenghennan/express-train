{
  "name": "express-train",
  "version": "0.1.0",
  "private": true,
  "description": "讲明白：本地优先的个人综合表达训练系统。",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
